+/* Both section headings ("Completed developments" and "Available to build") are the same flex row: the title
+   (text + count pill) and, on the Available one, the Develop-all buttons. Everything in the row is centred on
+   one line by flexbox - not nudged with vertical-align - so the pill, the title text and the buttons share a
+   centre, and the two headings treat their pills identically. min-height is the button height plus the
+   heading's padding, so the Completed heading (no buttons) is as tall as the Available one's content row and
+   both sit the same distance above their cards. */
 .section-header {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 16px;
   font-size: 1.1rem;
   font-weight: bold;
