From: Claude <noreply@anthropic.com>
Date: Sun, 8 Nov 2026 11:46:33 +0000
Subject: [PATCH] Top bar: time, rank, cash and reputation in their own white
 boxes, two by two

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0115oetuNdXfmPV3rBHJ3PDF
---
 hyperloop-ui/src/components/TopBanner.css | 30 ++++++++++++++++++++---
 hyperloop-ui/src/components/TopBanner.jsx |  6 ++---
 2 files changed, 29 insertions(+), 7 deletions(-)

diff --git a/hyperloop-ui/src/components/TopBanner.css b/hyperloop-ui/src/components/TopBanner.css
index 44b9b61..90961a1 100644
--- a/hyperloop-ui/src/components/TopBanner.css
+++ b/hyperloop-ui/src/components/TopBanner.css
@@ -83,15 +83,32 @@ font-size: 1rem;
     margin: 8px 0;
 }
 
+/* The four readouts sit in their own white boxes, two across and two down, in reading order (the grid fills column by
+   column, so the markup order Time, Rank, Cash, Reputation lays out as  Time | Cash  over  Rank | Reputation).
+   The boxes are always white with dark text, whatever the equipped theme does to the bar's own colours, so the values
+   stay readable on a dark bar too. Each column is as wide as its widest box, so the two in a column line up. */
 .rightSideDetails {
-    display: flex;
-    flex-direction: column;
-    justify-content: center;
+    display: grid;
+    grid-template-rows: repeat(2, auto);
+    grid-auto-flow: column;
+    align-content: center;
+    gap: 6px 8px;
     padding: 8px 16px;
-    gap: 4px;
     border-right: 1px solid #ccc;
 }
 
+.rightSideDetails > .time,
+.rightSideDetails > .rank,
+.rightSideDetails > .balance,
+.rightSideDetails > .reputation {
+    background: #fff;
+    color: #222;
+    border: 1px solid #e3d3bd;
+    border-radius: 8px;
+    padding: 5px 10px;
+    font-size: 0.9rem;
+}
+
 .rightSideDetails img {
     height: 16px;
     width: 16px;
@@ -366,6 +383,11 @@ font-size: 1rem;
    no longer fit side by side: the name was squeezed to nothing and the header grew. Both buttons shrink together below
    1200px, so they stay the same size as each other, and the margins tighten. */
 @media (max-width: 1200px) {
+    .rightSideDetails { gap: 4px 6px; padding: 8px 10px; }
+    .rightSideDetails > .time,
+    .rightSideDetails > .rank,
+    .rightSideDetails > .balance,
+    .rightSideDetails > .reputation { padding: 4px 8px; font-size: 0.8rem; }
     .work-banner-btn,
     .ShopButton {
         height: 46px;
diff --git a/hyperloop-ui/src/components/TopBanner.jsx b/hyperloop-ui/src/components/TopBanner.jsx
index d580300..0043041 100644
--- a/hyperloop-ui/src/components/TopBanner.jsx
+++ b/hyperloop-ui/src/components/TopBanner.jsx
@@ -237,8 +237,8 @@ function TopBanner({ terminalName, balance, rank, activeTab, onSelect, reputatio
         : null
     // Follows the equipped theme's bar text colour (same var .time/.rank already use via CSS) so balance and
     // reputation stay readable on a dark bar theme - was hardcoded dark grey, invisible on themes like Rockstar.
-    const balanceColor = balanceFlash === 'down' ? '#e74c3c' : 'var(--ui-bar-text, #333)'
-    const repColor = repFlash === 'down' ? '#e74c3c' : 'var(--ui-bar-text, #333)'
+    const balanceColor = balanceFlash === 'down' ? '#e74c3c' : '#222'
+    const repColor = repFlash === 'down' ? '#e74c3c' : '#222'
 
     return (
         <>
@@ -281,7 +281,7 @@ function TopBanner({ terminalName, balance, rank, activeTab, onSelect, reputatio
                     <img src={cashIcon} alt="balance" /> £{formatBalance(displayBalance)}
                     {balanceFloat && (
                         <span key={balanceFloat.id} style={{
-                            position: 'absolute', left: 0, top: 0, width: '100%',
+                            position: 'absolute', left: 10, top: 5, width: 'calc(100% - 10px)',
                             color: balanceFloat.dir === 'down' ? '#e74c3c' : '#888',
                             animation: 'stat-float-up 0.6s ease-out forwards',
                             pointerEvents: 'none', whiteSpace: 'nowrap',
