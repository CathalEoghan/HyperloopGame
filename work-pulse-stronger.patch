+.work-banner-btn.work-event-boost   { border-color: #27ae60; outline: 3px solid #27ae60; outline-offset: 2px; animation-name: work-pulse-boost; animation-duration: 1.3s; animation-timing-function: ease-out; }
+.work-banner-btn.work-event-penalty { border-color: #e74c3c; outline: 3px solid #e74c3c; outline-offset: 2px; animation-name: work-pulse-penalty; animation-duration: 1.3s; animation-timing-function: ease-out; }
 .work-banner-btn.work-event-boost:hover,   .work-banner-btn.work-event-boost:active,   .work-banner-btn.work-event-boost.work-banner-auto,
 .work-banner-btn.work-event-penalty:hover, .work-banner-btn.work-event-penalty:active, .work-banner-btn.work-event-penalty.work-banner-auto {
     animation: none;
 }
 
